    <worksheet name='YearoverYear Percentage'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>YoY % Change</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales (Sales)' name='federated.0gcxl4p1k0d82r18piuag1sufx6g' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='2013' caption='Year Parameter' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2013-01-01#'>
              <calculation class='tableau' formula='#2013-01-01#' />
              <aliases>
                <alias key='#2011-01-01#' value='2011' />
                <alias key='#2012-01-01#' value='2012' />
                <alias key='#2013-01-01#' value='2013' />
                <alias key='#2014-01-01#' value='2014' />
                <alias key='#2015-01-01#' value='2015' />
                <alias key='#2016-01-01#' value='2016' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gcxl4p1k0d82r18piuag1sufx6g'>
            <column caption='Chosen Year Profit' datatype='integer' name='[Calculation_0479946244358148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Date - Year] = [Parameters].[Parameter 1] THEN [Profit] END' />
            </column>
            <column caption='Last Year Profit' datatype='integer' name='[Calculation_0479946245160965]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Date - Year] = DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1]) THEN [Profit] END' />
            </column>
            <column caption='YoY% Change' datatype='real' name='[Calculation_0479946245861382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_0479946244358148]) - SUM([Calculation_0479946245160965]))/ SUM([Calculation_0479946245160965])' />
            </column>
            <column caption='&quot;YoY % Change&quot;' datatype='string' name='[Calculation_0479946246959112]' role='dimension' type='nominal' user:unnamed='YearoverYear Percentage'>
              <calculation class='tableau' formula='&quot;YoY % Change&quot;' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[Date - Year]' role='dimension' type='quantitative' user:agg-type='Year-Trunc' user:base-field='Date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;year&apos;, [Date]))' />
            </column>
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column datatype='integer' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Profit]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0479946246959112]' derivation='None' name='[none:Calculation_0479946246959112:nk]' pivot='key' type='nominal' />
            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0479946245861382]' derivation='User' name='[usr:Calculation_0479946245861382:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <slices>
