      <column caption='Age Group' datatype='string' name='[Age_Group]' role='dimension' type='nominal' />
      <column caption='Year Filter' datatype='boolean' name='[Calculation_0479946243870723]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Date - Year] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Chosen Year Profit' datatype='integer' name='[Calculation_0479946244358148]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Date - Year] = [Parameters].[Parameter 1] THEN [Profit] END' />
      </column>
      <column caption='Last Year Profit' datatype='integer' name='[Calculation_0479946245160965]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Date - Year] = DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1]) THEN [Profit] END' />
      </column>
      <column caption='YoY% Change' datatype='real' name='[Calculation_0479946245861382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_0479946244358148]) - SUM([Calculation_0479946245160965]))/ SUM([Calculation_0479946245160965])' />
      </column>
